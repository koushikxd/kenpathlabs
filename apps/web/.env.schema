# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=1)
DATABASE_URL=

# @type=string(minLength=1)
DIRECT_URL=

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=

# Lets Playwright fix server time per request with an x-test-now header. Never honoured in a production build.
# @type=boolean @sensitive=false
ALLOW_TEST_CLOCK=false
