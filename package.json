{
  "name": "kenpathlabs",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @kenpathlabs/db --",
    "db:studio": "turbo run db:studio -F @kenpathlabs/db --",
    "db:generate": "turbo run db:generate -F @kenpathlabs/db --",
    "db:migrate": "turbo run db:migrate -F @kenpathlabs/db --",
    "db:seed": "turbo run db:seed -F @kenpathlabs/db --",
    "db:start": "turbo run db:start -F @kenpathlabs/db --",
    "db:watch": "turbo run db:watch -F @kenpathlabs/db --",
    "db:stop": "turbo run db:stop -F @kenpathlabs/db --",
    "db:down": "turbo run db:down -F @kenpathlabs/db --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "check": "oxlint && oxfmt --write",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || test ! -e .git"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kenpathlabs/config": "workspace:*",
    "@oxlint/plugins": "1.83.0",
    "@types/node": "catalog:",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.83.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@11.21.0"
}
